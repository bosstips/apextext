import SwiftUI
import UniformTypeIdentifiers
import AppKit

struct MarkdownDocument: FileDocument {
    static var readableContentTypes: [UTType] { [.plainText, UTType(filenameExtension: "md") ?? .plainText] }
    var text: String = "# 欢迎使用 typeX\n\n专注文字，让想法自然展开。\n\n## 开始写作\n\n使用 **Markdown** 记录你的想法。\n"
    init() {}
    init(configuration: ReadConfiguration) throws {
        guard let data = configuration.file.regularFileContents, let value = String(data: data, encoding: .utf8) else { throw CocoaError(.fileReadInapplicableStringEncoding) }
        text = value
    }
    func fileWrapper(configuration: WriteConfiguration) throws -> FileWrapper { FileWrapper(regularFileWithContents: Data(text.utf8)) }
}

@main struct TypeXApp: App {
    var body: some Scene {
        DocumentGroup(newDocument: MarkdownDocument()) { file in Editor(document: file.$document) }
            .commands { CommandGroup(after: .textEditing) { Button("查找与替换") { NSApp.sendAction(#selector(NSTextView.performFindPanelAction(_:)), to: nil, from: FindSender()) }.keyboardShortcut("f") } }
    }
}
final class FindSender: NSObject { @objc var tag: Int { 1 } }

struct Editor: View {
    @Binding var document: MarkdownDocument
    @State private var preview = true
    @State private var focus = false
    @State private var selectedLine: Int? = nil
    @State private var jumpID = UUID()
    private var blocks: [MarkdownBlock] { MarkdownBlock.parse(document.text) }
    private var headings: [MarkdownBlock] { blocks.filter { $0.level > 0 } }
    var body: some View {
        HSplitView {
            if !focus {
                VStack(alignment: .leading, spacing: 16) {
                    Text("typeX").font(.system(size: 26, weight: .bold, design: .rounded))
                    Text("文档大纲").font(.caption).foregroundStyle(.secondary)
                    ScrollView {
                        VStack(alignment: .leading, spacing: 6) {
                            ForEach(headings) { item in
                                Button { selectedLine = item.id; jumpID = UUID() } label: {
                                    Text(item.text).font(.callout).lineLimit(2)
                                        .padding(.leading, CGFloat(item.level - 1) * 10)
                                        .padding(6).frame(maxWidth: .infinity, alignment: .leading)
                                        .background(selectedLine == item.id ? Color.accentColor.opacity(0.15) : Color.clear)
                                        .cornerRadius(5)
                                }.buttonStyle(.plain)
                            }
                        }
                    }
                    Spacer()
                    Text("本地文件 · 专注写作").font(.caption2).foregroundStyle(.secondary)
                }.padding(22).frame(minWidth: 160, idealWidth: 200, maxWidth: 260).background(.bar)
            }
            if preview {
                ScrollViewReader { proxy in
                    ScrollView {
                        VStack(alignment: .leading, spacing: 16) {
                            ForEach(blocks) { block in
                                Group {
                                    if block.code {
                                        Text(block.text).font(.system(.body, design: .monospaced))
                                            .padding(12).frame(maxWidth: .infinity, alignment: .leading)
                                            .background(Color.secondary.opacity(0.08)).cornerRadius(6)
                                    } else {
                                        Text((try? AttributedString(markdown: block.text, options: .init(interpretedSyntax: .inlineOnlyPreservingWhitespace))) ?? AttributedString(block.text))
                                            .font(block.level > 0 ? .system(size: [32.0, 26, 22, 19, 17, 16][block.level - 1], weight: .bold) : .system(size: 16))
                                            .frame(maxWidth: .infinity, alignment: .leading)
                                    }
                                }.textSelection(.enabled).id(block.id)
                            }
                        }.frame(maxWidth: 780, alignment: .leading).padding(36).frame(maxWidth: .infinity, alignment: .topLeading)
                    }
                    .onChange(of: jumpID) { _, _ in if let selectedLine { proxy.scrollTo(selectedLine, anchor: .top) } }
                    .onAppear { if let selectedLine { proxy.scrollTo(selectedLine, anchor: .top) } }
                }.frame(minWidth: 400)
            } else {
                NativeEditor(text: $document.text, selectedLine: selectedLine, jumpID: jumpID).frame(minWidth: 400)
            }
        }
        .frame(minWidth: 760, minHeight: 520)
        .toolbar {
            ToolbarItem { Button { focus.toggle() } label: { Label("专注模式", systemImage: "sidebar.left") }.keyboardShortcut("\\", modifiers: .command) }
            ToolbarItem {
                Picker("显示模式", selection: $preview) {
                    Text("编辑").tag(false)
                    Text("预览").tag(true)
                }.pickerStyle(.segmented).frame(width: 160)
            }
        }
        .safeAreaInset(edge: .bottom) {
            HStack { Text("Markdown · UTF-8"); Spacer(); Text("\(document.text.count) 字符   \(document.text.components(separatedBy: "\n").count) 行") }.font(.caption).foregroundStyle(.secondary).padding(.horizontal, 18).padding(.vertical, 8).background(.bar)
        }
    }
}

struct NativeEditor: NSViewRepresentable {
    @Binding var text: String
    var selectedLine: Int?
    var jumpID: UUID
    func makeCoordinator() -> Coordinator { Coordinator(self) }
    func makeNSView(context: Context) -> NSScrollView {
        let scroll = NSTextView.scrollableTextView()
        let view = scroll.documentView as! NSTextView
        view.isRichText = false
        view.font = .monospacedSystemFont(ofSize: 16, weight: .regular)
        view.textContainerInset = NSSize(width: 24, height: 28)
        view.isAutomaticQuoteSubstitutionEnabled = false
        view.isAutomaticDashSubstitutionEnabled = false
        view.allowsUndo = true
        view.usesFindBar = true
        view.isIncrementalSearchingEnabled = true
        view.delegate = context.coordinator
        view.string = text
        return scroll
    }
    func updateNSView(_ scroll: NSScrollView, context: Context) {
        context.coordinator.parent = self
        let view = scroll.documentView as! NSTextView
        if view.string != text && !view.hasMarkedText() { view.string = text }
        if context.coordinator.lastJump != jumpID, let selectedLine {
            context.coordinator.lastJump = jumpID
            let lines = text.components(separatedBy: "\n")
            let offset = lines.prefix(max(0, selectedLine)).reduce(0) { $0 + ($1 as NSString).length + 1 }
            let range = NSRange(location: min(offset, (text as NSString).length), length: 0)
            view.setSelectedRange(range)
            view.scrollRangeToVisible(range)
        }
    }
    final class Coordinator: NSObject, NSTextViewDelegate {
        var lastJump: UUID?
        var parent: NativeEditor
        init(_ parent: NativeEditor) { self.parent = parent }
        func textDidChange(_ notification: Notification) { guard let view = notification.object as? NSTextView else { return }; parent.text = view.string }
    }
}

struct MarkdownBlock: Identifiable {
    let id: Int
    let text: String
    var level: Int = 0
    var code: Bool = false

    static func parse(_ source: String) -> [MarkdownBlock] {
        let lines = source.components(separatedBy: "\n")
        var result: [MarkdownBlock] = []
        var i = 0
        while i < lines.count {
            let line = lines[i]
            let trimmed = line.trimmingCharacters(in: .whitespaces)
            if trimmed.isEmpty { i += 1; continue }
            if trimmed.hasPrefix("```") || trimmed.hasPrefix("~~~") {
                let marker = trimmed.first!
                let count = trimmed.prefix(while: { $0 == marker }).count
                let start = i
                i += 1
                var content: [String] = []
                while i < lines.count {
                    let candidate = lines[i].trimmingCharacters(in: .whitespaces)
                    if candidate.prefix(while: { $0 == marker }).count >= count && candidate.allSatisfy({ $0 == marker }) { break }
                    content.append(lines[i]); i += 1
                }
                result.append(.init(id: start, text: content.joined(separator: "\n"), code: true))
                i += 1; continue
            }
            let hashes = trimmed.prefix(while: { $0 == "#" }).count
            if (1...6).contains(hashes), trimmed.count == hashes || trimmed.dropFirst(hashes).first == " " || trimmed.dropFirst(hashes).first == "\t" {
                result.append(.init(id: i, text: String(trimmed.dropFirst(hashes)).trimmingCharacters(in: .whitespaces), level: hashes))
            } else if i + 1 < lines.count {
                let underline = lines[i + 1].trimmingCharacters(in: .whitespaces)
                if !underline.isEmpty && (underline.allSatisfy { $0 == "=" } || underline.allSatisfy { $0 == "-" }) {
                    result.append(.init(id: i, text: line, level: underline.first == "=" ? 1 : 2)); i += 1
                } else { result.append(.init(id: i, text: line)) }
            } else { result.append(.init(id: i, text: line)) }
            i += 1
        }
        return result
    }
}
